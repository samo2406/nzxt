# Copy to agent/.env and fill in. agent/.env is gitignored.

# Azure Speech resource (Free F0). Portal → Speech service → Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# TTS_VOICE=sk-SK-LukasNeural
# TTS_RATE=1.05
# WAKE_MODEL=hey_jarvis
# WAKE_THRESHOLD=0.5
# MIC_DEVICE=FIFINE
# SPEAKER_DEVICE=
# FOLLOW_UP_SECONDS=5
# END_SILENCE_MS=450
# FACE_PORT=8765
