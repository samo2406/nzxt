# Copy to agent/.env and fill in. agent/.env is gitignored.

# Azure Speech resource (Free F0). Portal → Speech service → Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Optional overrides
# PITU_MODEL=claude-haiku-5-5
# PITU_EFFORT=low
# TTS_VOICE=sk-SK-LukasNeural
# TTS_RATE=1.05
# WAKE_MODEL=hey_jarvis   # stock English "Hey Jarvis" instead of models/hej_pitu.onnx
# WAKE_THRESHOLD=0.5
# MIC_DEVICE=FIFINE
# SPEAKER_DEVICE=          # part of a device name; several, comma-separated, play at once
# VOLUME=1.0               # Piťu's own loudness, 0-1 (beeps and speech)
# FOLLOW_UP_SECONDS=5
# END_SILENCE_MS=450
# FACE_PORT=8765
# 1 = also let the local dev server (127.0.0.1:5173 / :4173) connect to the face link
# FACE_DEV_ORIGINS=1
# Other apps' volume while Piťu listens and talks, as a fraction (1 = no ducking)
# DUCK_LEVEL=0.3
